==> 000000b0: <LoadConstString>: <Reg8: 16, string_id: 9488>  # String: ";\n\nvar c=document.getElementById('c');\nvar ctx=c.getContext('2d');\nvar dpr=window.devicePixelRatio||1;\nvar S=0;\nvar textWidth=0;\nvar gap=60;\nvar segmentWidth=0;\nvar offsetX=0;\nvar stepSize=0;\nvar iTimer=null;\n\nfunction init(){\n  S=Math.min(window.innerWidth,window.innerHeight);\n  if(S<=0){setTimeout(init,50);return;}\n  c.width=S*dpr;\n  c.height=S*dpr;\n  c.style.width=S+'px';\n  c.style.height=S+'px';\n\n  ctx.save();\n  ctx.scale(dpr,dpr);\n  ctx.font=FONTSIZE+'px sans-serif';\n  textWidth=ctx.measureText(TEXT).width;\n  ctx.restore();\n\n  segmentWidth=textWidth+gap;\n  stepSize=segmentWidth/200;\n  speed=segmentWidth/10000;\n\n  render();\n  iTimer=requestAnimationFrame(animLoop);\n}\n// init() 移到所有函数定义之后\n\nfunction render(){\n  ctx.save();\n  ctx.setTransform(dpr,0,0,dpr,0,0);\n\n  // 清屏\n  ctx.fillStyle='#000';\n  ctx.fillRect(0,0,S,S);\n\n  // 设置文字样式\n  ctx.fillStyle=COLOR;\n  ctx.font=FONTSIZE+'px sans-serif';\n  ctx.textBaseline='middle';\n\n  // 从 -segmentWidth 开始画，确保左边滚入时也有内容\n  var startX = -(offsetX % segmentWidth);\n  for(var x=startX; x<S; x+=segmentWidth){\n    ctx.fillText(TEXT, x, S/2);\n  }\n\n  ctx.restore();\n}\n\n// 速度：像素/毫秒（在 init 里赋值）\nvar speed=0;\nvar lastTime=0;\n\nfunction animLoop(ts){\n  if(!lastTime)lastTime=ts;\n  var dt=ts-lastTime;\n  lastTime=ts;\n  offsetX+=speed*dt;\n  render();\n  iTimer=requestAnimationFrame(animLoop);\n}\n\nfunction tick(){\n  offsetX+=stepSize;\n  render();\n}\n\n// 导出接口\nwindow.pauseAnimation=function(){if(iTimer){cancelAnimationFrame(iTimer);iTimer=null;}};\nwindow.resumeAnimation=function(){if(!iTimer){lastTime=0;iTimer=requestAnimationFrame(animLoop);}};\nwindow.stepFrame=function(n){n=n||1;for(var i=0;i<n;i++){offsetX+=stepSize;}render();};\nwindow.getTotalSteps=function(){return 200;};\n\n// 批量导出\nwindow.exportFrames=function(totalSteps){\n  try{\n    cancelAnimationFrame(iTimer);iTimer=null;\n    offsetX=0;\n\n    // 完全独立的 720px 坐标系，不依赖显示 canvas 的任何变量\n    var eS=720;\n    var ec=document.createElement('canvas');\n    ec.width=eS;ec.height=eS;\n    var ectx=ec.getContext('2d');\n\n    // 字体按比例放大到 720px canvas\n    var eFontSize=Math.round(FONTSIZE*eS/S);\n\n    // 在导出 canvas 上独立测量文字宽度\n    ectx.font=eFontSize+'px sans-serif';\n    var eTextWidth=ectx.measureText(TEXT).width;\n    var eGap=Math.round(60*eS/S);\n    var eSegW=eTextWidth+eGap;\n    // 每步移动量：整数像素，避免抖动\n    var eStep=Math.max(1, Math.round(eSegW/200));\n    var eOffset=0;\n\n    function eRender(){\n      ectx.fillStyle='#000';\n      ectx.fillRect(0,0,eS,eS);\n      ectx.fillStyle=COLOR;\n      ectx.font=eFontSize+'px sans-serif';\n      ectx.textBaseline='middle';\n      var x=-(eOffset % eSegW);\n      while(x<eS){\n        ectx.fillText(TEXT,x,eS/2);\n        x+=eSegW;\n      }\n    }\n\n    var frameIdx=0,BATCH=10;\n    function processBatch(){\n      try{\n        var batch=[];\n        var end=Math.min(frameIdx+BATCH,totalSteps);\n        for(var i=frameIdx;i<end;i++){\n          eOffset+=eStep;\n          eRender();\n          batch.push({i:i,d:ec.toDataURL('image/jpeg',0.9)});\n        }\n        frameIdx=end;\n        window.ReactNativeWebView.postMessage(JSON.stringify({t:'b',f:batch}));\n        if(frameIdx<totalSteps) setTimeout(processBatch,0);\n        else window.ReactNativeWebView.postMessage(JSON.stringify({t:'d',n:totalSteps}));\n      }catch(e){window.ReactNativeWebView.postMessage(JSON.stringify({t:'e',m:''+e}));}\n    }\n    processBatch();\n  }catch(e){window.ReactNativeWebView.postMessage(JSON.stringify({t:'e',m:''+e}));}\n};\n\n// 所有函数定义完毕，启动初始化\ninit();\n\n} catch(err) {\n  document.body.style.color='red';\n  document.body.innerText='Error: '+err.message;\n}\n</script></body></html>" (String)
